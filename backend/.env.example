# APCOTEX Sales Insights — Backend environment (example)
# Copy to `.env` and fill in real values. Never commit secrets.
# Every variable is optional; defaults live in app/core/config.py.

# ==========================================
# Application
# ==========================================
APP_NAME=APCOTEX Sales Insights API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ==========================================
# CORS — comma-separated browser origins (exact match: scheme + host + port)
# List every origin users open in the browser. Whitespace is trimmed.
# Example — local + UAT together:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://<SERVER-IP>:5173
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# PostgreSQL
# ==========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=apcotex_salesinsights
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/apcotex_salesinsights
# DB_ECHO=false
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ==========================================
# Microsoft Graph (fill from Azure app registration)
# Application permissions: Mail.Read (Outlook sync) and Mail.ReadWrite
# (create drafts in GRAPH_MAILBOX — admin consent required).
# Do NOT use /sendMail — drafts are reviewed and sent manually in Outlook.
# ==========================================
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=reports-mailbox@example.com

# ==========================================
# Logging / retention
# ==========================================
LOG_LEVEL=INFO
MASTER_HISTORY_RETENTION_DAYS=180

# ==========================================
# Authentication: headers (local/VPN UAT) | trusted_headers | jwt
# trusted_headers requires AUTH_TRUSTED_SECRET; jwt requires AUTH_JWT_SECRET.
# ==========================================
AUTH_MODE=headers
AUTH_TRUSTED_SECRET=
AUTH_JWT_SECRET=
PASSWORD_MIN_LENGTH=8
# Read only by scripts/seed.py for the first Super Admin. Login never reads it.
SUPER_ADMIN_PASSWORD=

# ==========================================
# Amazon Bedrock. The host IAM role supplies credentials. Do not set access keys.
# The active model is chosen in Admin Settings. Leave DEFAULT_MODEL unset to use
# the registry default.
# ==========================================
AWS_REGION=ap-south-1
# BEDROCK_REGION=
BEDROCK_TIMEOUT=30

# ==========================================
# Chat with Data (disabled unless CHAT_DATA_ENABLED=true)
# ==========================================
CHAT_DATA_ENABLED=false
CHAT_DATA_USE_LLM=true
CHAT_DATA_LLM_PHRASING=false
# Semantic matching requires the chat_embeddings migration and scripts/sync_chat_embeddings.py.
CHAT_SEMANTIC_SEARCH_ENABLED=false
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# BEDROCK_EMBEDDING_DIMENSIONS=1024

# ==========================================
# ERP Excel quantity unit (MT = use workbook numbers as-is; KG divides by 1000)
# ==========================================
ERP_EXCEL_QUANTITY_UNIT=MT
